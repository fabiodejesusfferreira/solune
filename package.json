{
  "name": "solune",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm tokens",
    "dev": "cargo build -p solune-daemon && pnpm --filter @solune/desktop dev",
    "dev:daemon": "cargo daemon",
    "dev:ui": "pnpm --filter @solune/desktop dev:ui",
    "build": "pnpm tokens && node scripts/stage-daemon.mjs && pnpm --filter @solune/desktop build",
    "ipc:fixtures": "node scripts/ipc-fixtures.mjs",
    "tokens": "pnpm --filter @solune/tokens build",
    "version:set": "node scripts/set-version.mjs",
    "lint": "biome check . && node scripts/check-colors.mjs",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
