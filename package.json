{
  "name": "solune",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "pnpm --filter @solune/tokens build",
    "lint": "biome check . && node scripts/check-colors.mjs",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
